{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"noEmit": true
	},
	"include": ["**/*.ts"]
}
